# The one backend URL. Identity, CRM, Voice, Report and marketplace are all
# served by the single API (app.main:app) on this origin.
# Local development defaults to the FastAPI server. Set the stable HTTPS API
# origin per Netlify/CI deployment; never commit a rotating ngrok URL.
REACT_APP_BACKEND_URL=http://localhost:8000
 

# DEPRECATED — kept only so existing deployments keep booting. Both always
# pointed at the same monolith. src/lib/api.js reads REACT_APP_BACKEND_URL
# first; set that one and delete these.
# REACT_APP_VOICE_AGENT_URL=http://localhost:8000
# REACT_APP_REPORT_AGENT_URL=http://localhost:8000

# ---- NVIP shell (src/api/client.js, from predev) ----
# Copy to .env and adjust. Restart `npm start` after changing it.

# NVIP backend origin (the frontend calls <origin>/api/v1/...).
REACT_APP_NVIP_API_URL=http://localhost:8000

# true (default): serve built-in demo data, no backend needed.
# false: call the real NVIP backend at REACT_APP_NVIP_API_URL.
REACT_APP_NVIP_USE_MOCKS=true
